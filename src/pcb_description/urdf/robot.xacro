<?xml version="1.0"?>
<robot name="simple_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
        
        <xacro:arg name="use_sim" default="false" />

        <!-- Chargement des propriétés Gazebo si on est en simu -->
        
        <xacro:if value="$(arg use_sim)">
                <xacro:include filename="$(find pcb_simulation)/urdf/gazebo.xacro"/>
        </xacro:if>

        <!-- ================= PARAMETERS ================= -->

        <!-- Base (reprend ton gros robot) -->
        <xacro:property name="base_length" value="0.25"/>
        <xacro:property name="base_width" value="0.25"/>
        <xacro:property name="base_height" value="0.35"/>

        <!-- Roues (reprend ton modèle initial) -->
        <xacro:property name="wheel_radius" value="0.05"/>
        <xacro:property name="wheel_width"  value="0.03"/>

        <!-- Position roues (CORRIGÉE) -->
        <xacro:property name="wheel_offset_x" value="${base_length/2 - 0.01}"/>
        <xacro:property name="wheel_offset_y" value="${base_width/2 - 0.01}"/>

        <!-- Hauteur base -->
        <xacro:property name="base_z" value="${wheel_radius + base_height/2}"/>

        <link name="base_footprint"/>

        <!-- ================= MATERIALS ================= -->

        <material name="blue">
                <color rgba="0 0 1 1"/>
        </material>
        <material name="red">
                <color rgba="1 0 0 1"/>
        </material>
        <material name="green">
                <color rgba="0 1 0 1"/>
        </material>
        <material name="yellow">
                <color rgba="1 1 0 1"/>
        </material>
        <material name="magenta">
                <color rgba="1 0 1 1"/>
        </material>
        <material name="cyan">
                <color rgba="0 1 1 1"/>
        </material>
        <material name="white">
                <color rgba="1 1 1 1"/>
        </material>

        <!-- ================= BASE ================= -->

        <link name="base_link">
                <visual>
                        <geometry>
                                <box size="${base_length} ${base_width} ${base_height}"/>
                        </geometry>
                        <material name="red"/>
                </visual>

                <collision>
                        <geometry>
                                <box size="${base_length} ${base_width} ${base_height}"/>
                        </geometry>
                </collision>

                <inertial>
                        <mass value="10"/>
                        <inertia ixx="0.15" iyy="0.15" izz="0.1" ixy="0" ixz="0" iyz="0"/>
                </inertial>
        </link>

        <joint name="base_joint" type="fixed">
                <parent link="base_footprint"/>
                <child link="base_link"/>
                <origin xyz="0 0 ${base_z}"/>
        </joint>

        <!-- ================= FRONT VISUAL ================= -->

        <link name="front_visual">
                <visual>
                        <geometry>
                                <box size="0.08 0.20 0.05"/>
                        </geometry>
                        <material name="yellow"/>
                </visual>
        </link>

        <joint name="front_visual_joint" type="fixed">
                <parent link="base_link"/>
                <child link="front_visual"/>
                <origin xyz="${base_length/2 - 0.03} 0 ${base_height/2 - 0.015}"/>
        </joint>

        <!-- ================= MACRO ROUE ================= -->

        <xacro:macro name="wheel" params="name x y angle axis_y">
                <link name="${name}_link">
                        <visual>
                                <geometry>
                                        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                                </geometry>
                                <origin rpy="${pi/2} 0 0"/>
                                <material name="blue"/>
                        </visual>

                        <collision>
                                <geometry>
                                        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                                </geometry>
                                <origin rpy="${pi/2} 0 0"/>
                        </collision>

                        <inertial>
                                <mass value="0.15"/>
                                <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
                        </inertial>
                </link>

                <joint name="${name}_joint" type="continuous">
                        <parent link="base_link"/>
                        <child link="${name}_link"/>
                        <origin xyz="${x} ${y} ${-base_height/2}" rpy="0 0 ${angle}"/>
                        <axis xyz="0 ${axis_y} 0"/>
                </joint>
        </xacro:macro>

        <!-- ================= WHEELS ================= -->

        <!-- position EXACTE au bord (plus dans le cube) -->
        <xacro:wheel name="rf" x="${wheel_offset_x}" y="${-wheel_offset_y}" angle="${pi/4}" axis_y="-1"/>
        <xacro:wheel name="rb" x="${-wheel_offset_x}" y="${-wheel_offset_y}" angle="${-pi/4}" axis_y="-1"/>
        <xacro:wheel name="lf" x="${wheel_offset_x}" y="${wheel_offset_y}" angle="${-pi/4}" axis_y="1"/>
        <xacro:wheel name="lb" x="${-wheel_offset_x}" y="${wheel_offset_y}" angle="${pi/4}" axis_y="1"/>

        <!-- ================= LIDAR ================= -->

        <link name="lidar_link">
                <visual>
                        <geometry>
                                <cylinder length="0.05" radius="0.04"/>
                        </geometry>
                        <material name="green"/>
                </visual>
        </link>

        <joint name="lidar_joint" type="fixed">
                <parent link="base_link"/>
                <child link="lidar_link"/>
                <!-- posé sur la base -->
                <origin xyz="0 0 ${base_height/2 + 0.05/2}"/>
        </joint>

        <!-- ================= ROS2 CONTROL ================= -->

        <ros2_control name="RobotController" type="system">
                <hardware>
                        <xacro:if value="$(arg use_sim)">
                                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                        </xacro:if>

                        <xacro:unless value="$(arg use_sim)">
                                <plugin>micro_ros_hardware/MicroRosHardwareInterface</plugin>
                                <!-- Les paramètres optionnels lus par ton on_init() -->
                                <param name="cmd_topic">/wheel_commands</param>
                                <param name="state_topic">/micro_controller/joint_states</param>
                        </xacro:unless>
                </hardware>

                <joint name="lf_joint">
                        <command_interface name="velocity"/>
                        <state_interface name="position"/>
                        <state_interface name="velocity"/>
                </joint>

                <joint name="rf_joint">
                        <command_interface name="velocity"/>
                        <state_interface name="position"/>
                        <state_interface name="velocity"/>
                </joint>

                <joint name="rb_joint">
                        <command_interface name="velocity"/>
                        <state_interface name="position"/>
                        <state_interface name="velocity"/>
                </joint>

                <joint name="lb_joint">
                        <command_interface name="velocity"/>
                        <state_interface name="position"/>
                        <state_interface name="velocity"/>
                </joint>

        </ros2_control>

        <xacro:if value="$(arg use_sim)">
                <gazebo>
                        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                                <parameters>$(find pcb_bringup)/config/sim/robot_controller.yaml</parameters>
                        </plugin>
                </gazebo>
        </xacro:if>

</robot>